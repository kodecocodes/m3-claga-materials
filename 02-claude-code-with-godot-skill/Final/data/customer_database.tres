script = ExtResource("1_db")
customers = Array[ExtResource("2_customer")]([SubResource("c_person"), SubResource("c_woman"), SubResource("c_man"), SubResource("c_red_hair"), SubResource("c_curly_hair"), SubResource("c_white_hair"), SubResource("c_bald"), SubResource("c_blond"), SubResource("c_blond_f"), SubResource("c_red_hair_f"), SubResource("c_curly_hair_f"), SubResource("c_white_hair_f"), SubResource("c_bald_f"), SubResource("c_older"), SubResource("c_old_man"), SubResource("c_old_woman"), SubResource("c_child"), SubResource("c_boy"), SubResource("c_girl"), SubResource("c_baby"), SubResource("c_with_bottle"), SubResource("c_graduate"), SubResource("c_graduate_f"), SubResource("c_graduate_m"), SubResource("c_guard"), SubResource("c_guard_f"), SubResource("c_officer"), SubResource("c_officer_f"), SubResource("c_chef"), SubResource("c_chef_f"), SubResource("c_wizard"), SubResource("c_witch"), SubResource("c_cowboy"), SubResource("c_disguise"), SubResource("c_rockstar"), SubResource("c_elf"), SubResource("c_elf_f"), SubResource("c_mermaid"), SubResource("c_mermaid_f"), SubResource("c_fairy"), SubResource("c_fairy_f"), SubResource("c_vampire"), SubResource("c_vampire_f"), SubResource("c_zombie"), SubResource("c_zombie_f"), SubResource("c_genie"), SubResource("c_genie_f"), SubResource("c_astronaut"), SubResource("c_ninja"), SubResource("c_prince"), SubResource("c_princess")])
request_quips = Array[String](["I need something for my aching joints... could you whip up a {potion_name}?", "Got anything that'll make my mother-in-law like me? I heard a {potion_name} might do the trick.", "My cat's been talking to me. Got any {potion_name} that could help with that?", "Brew me a {potion_name}, I've got a dragon to negotiate with later.", "I'll take a {potion_name}. Make it strong, I've got a long night ahead."])
positive_quips = Array[String](["Oh, this is exactly what the doctor, er, witch, ordered!", "Whoa, I feel ten years younger already! Worth every coin.", "You've got real talent, kid. The old witch better watch her job.", "Perfect! My ears stopped ringing the moment I drank it!", "This is incredible, I'm telling everyone in town about this place!"])
negative_quips = Array[String](["Uh... is it supposed to smell like wet socks?", "I asked for courage, not a sudden urge to take a nap.", "My eyebrows weren't *this* color when I walked in here.", "This tastes like regret. Mostly mine, for choosing this shop.", "I think you mixed up the labels again — I'm starting to glow."])
