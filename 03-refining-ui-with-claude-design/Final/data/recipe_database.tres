[gd_resource type="Resource" script_class="RecipeDatabase" format=3 uid="uid://jev7umjmbibh"]

[ext_resource type="Script" uid="uid://ckmx5qjyvgskr" path="res://scripts/recipe_database.gd" id="1_db"]
[ext_resource type="Script" uid="uid://qgf62ruwsumm" path="res://scripts/potion_recipe.gd" id="2_recipe"]
