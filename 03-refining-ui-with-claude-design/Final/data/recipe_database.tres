[sub_resource type="Resource" id="recipe_moonveil"]
script = ExtResource("2_recipe")
id = &"moonveil_tincture"
potion_name = "Moonveil Tincture"
color = Color(0.788, 0.851, 0.91, 1)
description = "Renders the drinker translucent as morning fog, muffling their footsteps and masking their scent entirely. The effect lingers until the first light of sunrise."
required_ingredients = Array[String](["🌕", "🌫️"])

[sub_resource type="Resource" id="recipe_pyre"]
script = ExtResource("2_recipe")
id = &"pyre_of_the_pure"
potion_name = "Pyre of the Pure"
color = Color(1, 0.667, 0.2, 1)
description = "Purges poison, curse, and corruption from the body in a single burning surge. The pain is brief and brilliant; the relief, absolute and lasting."
required_ingredients = Array[String](["🔥", "🦄"])

[sub_resource type="Resource" id="recipe_silkweaver"]
script = ExtResource("2_recipe")
id = &"silkweavers_kiss"
potion_name = "Silkweaver's Kiss"
color = Color(0.831, 0.643, 0.353, 1)
description = "A thread of moonlight binds spider silk and honeyed sap into something stranger: the drinker's touch leaves unbreakable webs, and their movements become eerily silent and fluid."
required_ingredients = Array[String](["🕷️", "🍯", "🌕"])

[sub_resource type="Resource" id="ingredient_moon"]
script = ExtResource("3_ingredient")
emoji = "🌕"
ingredient_name = "Full Moon Tear"

