shelf_ingredients = Array[ExtResource("3_ingredient")]([SubResource("ingredient_moon"), SubResource("ingredient_mist"), SubResource("ingredient_fire"), SubResource("ingredient_unicorn"), SubResource("ingredient_spider"), SubResource("ingredient_honey")])
